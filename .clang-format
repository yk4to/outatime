BasedOnStyle: Google
IndentWidth: 4
ColumnLimit: 100
AccessModifierOffset: -4
IndentCaseLabels: false
DerivePointerAlignment: false
PointerAlignment: Left
# <windows.h> must come before other Windows headers.
IncludeCategories:
  - Regex: '^<windows\.h>$'
    Priority: 1
    SortPriority: 1
  - Regex: '^<.*\.h>$'
    Priority: 1
    SortPriority: 2
  - Regex: '^<.*>$'
    Priority: 3
  - Regex: '.*'
    Priority: 4
