#pragma once

// Generated by generate_version.cmake. Plain C so Outatime.rc can include it.

#define OUTATIME_VERSION_MAJOR @VERSION_MAJOR@
#define OUTATIME_VERSION_MINOR @VERSION_MINOR@
#define OUTATIME_VERSION_PATCH @VERSION_PATCH@
#define OUTATIME_VERSION "@VERSION@"
// "<version>+<full commit hash>", or just the version when built outside git.
#define OUTATIME_INFORMATIONAL_VERSION "@INFORMATIONAL_VERSION@"
