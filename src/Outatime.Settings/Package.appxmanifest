<?xml version="1.0" encoding="utf-8"?>
<!-- Used only for the MSIX package (dotnet publish -p:WindowsPackageType=MSIX).
     The package has Outatime.exe and Outatime.Settings.exe at its root. -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap desktop rescap">

  <!-- Placeholders until the name is reserved in Partner Center, which gives the Store's
       Name and Publisher. Version is <Version> in Outatime.Settings.csproj plus ".0". -->
  <Identity Name="Outatime" Publisher="CN=yk4to" Version="0.1.0.0" />

  <Properties>
    <DisplayName>Outatime</DisplayName>
    <PublisherDisplayName>yk4to</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <!-- The build sets both versions from TargetPlatformMinVersion and TargetFramework. -->
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.19041.0" />
  </Dependencies>

  <Resources>
    <Resource Language="x-generate" />
  </Resources>

  <Applications>
    <!-- The Start menu entry. Started again while running, it opens the settings app. -->
    <Application Id="Outatime" Executable="Outatime.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Outatime"
        Description="ms-resource:PackageDescription"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <!-- Replaces the Run key, which the package can't write. The settings app turns it on. -->
        <desktop:Extension Category="windows.startupTask" Executable="Outatime.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="Outatime" Enabled="false" DisplayName="Outatime" />
        </desktop:Extension>
      </Extensions>
    </Application>
    <Application Id="Settings" Executable="Outatime.Settings.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="ms-resource:AppTitle"
        Description="ms-resource:PackageDescription"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        AppListEntry="none" />
    </Application>
  </Applications>

  <Capabilities>
    <!-- Both apps are regular desktop apps, outside the app container. -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
