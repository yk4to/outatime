<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>Outatime.Settings</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <Platform Condition="'$(Platform)' == '' Or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>..\Outatime\icons\outatime.ico</ApplicationIcon>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- GitHub Actions sets CI=true: warnings fail CI without stopping local builds. -->
    <TreatWarningsAsErrors Condition="'$(CI)' == 'true'">true</TreatWarningsAsErrors>
    <!-- Outatime.exe takes its version from here too (src/Outatime/CMakeLists.txt). -->
    <Version>0.1.0</Version>
    <!-- The exe's file description, which Task Manager shows as its name. -->
    <AssemblyTitle>Outatime Switcher Settings</AssemblyTitle>
    <Product>Outatime Switcher</Product>
    <DefaultLanguage>en-US</DefaultLanguage>
    <!-- Program.Main handles single-instance redirection before starting XAML. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>

    <UseWinUI>true</UseWinUI>
    <!-- Unpackaged for the zip. -p:WindowsPackageType=MSIX builds the Store package instead. -->
    <WindowsPackageType Condition="'$(WindowsPackageType)' == ''">None</WindowsPackageType>
    <!-- Needed even when unpackaged: without it the app's .pri is left out of publish. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <PublishAot>true</PublishAot>

    <!-- Same layout as the zip: Outatime.exe + settings\Outatime.Settings.exe -->
    <OutDir>$(MSBuildThisFileDirectory)..\..\build\bin\$(Configuration)\settings\</OutDir>
    <!-- The package has both exes at its root. -->
    <OutDir Condition="'$(WindowsPackageType)' == 'MSIX'">$(MSBuildThisFileDirectory)..\..\build\msix\$(Configuration)\</OutDir>
    <IntermediateOutputPath Condition="'$(WindowsPackageType)' == 'MSIX'">obj\msix\$(Configuration)\</IntermediateOutputPath>
    <!-- One package with every language. A bundle leaves the languages out of the main
         package's manifest, so the app would only show English. -->
    <AppxBundle>Never</AppxBundle>

    <!-- Next to Outatime.exe, where the About section opens it. -->
    <ThirdPartyNoticesPath>$(OutDir)..\THIRD-PARTY-NOTICES.txt</ThirdPartyNoticesPath>
    <ThirdPartyNoticesPath Condition="'$(WindowsPackageType)' == 'MSIX'">$(IntermediateOutputPath)THIRD-PARTY-NOTICES.txt</ThirdPartyNoticesPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- Shown in the About section. -->
    <Content Include="..\Outatime\icons\outatime.png" Link="Assets\outatime.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Record only the PDB's file name in the exe, not the build machine's path. -->
    <LinkerArg Include="/PDBALTPATH:%25_PDB%25" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <!-- Unused parts of the Windows App SDK; excluding them keeps ~40 MB of DLLs out of the zip. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.AI" Version="2.5.5" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.ML" Version="2.1.94" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Search" Version="2.5.5" ExcludeAssets="all" />
    <!-- Dependencies of Microsoft.WindowsAppSDK.ML, which its ExcludeAssets doesn't reach. -->
    <PackageReference Include="Microsoft.Windows.AI.MachineLearning" Version="2.1.74" ExcludeAssets="all" />
    <PackageReference Include="System.Numerics.Tensors" Version="9.0.0" ExcludeAssets="all" />
  </ItemGroup>

  <ItemGroup Condition="'$(WindowsPackageType)' == 'MSIX'">
    <!-- The tile and Start menu images that Package.appxmanifest names (scripts/generate-icons.ps1). -->
    <Content Include="Assets\*.png" />
    <!-- Built by CMake first. -->
    <Content Include="..\..\build\bin\$(Configuration)\Outatime.exe" Link="Outatime.exe" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(ThirdPartyNoticesPath)" Link="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Needs a configured CMake tree. -->
  <Target Name="GenerateThirdPartyNotices" BeforeTargets="BeforeBuild">
    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(ThirdPartyNoticesPath)'))" />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\..\scripts\generate-notices.ps1&quot; -Output &quot;$(ThirdPartyNoticesPath)&quot;" />
  </Target>

  <!-- The package's version is fixed in Package.appxmanifest, so check that it follows <Version>. -->
  <Target Name="CheckPackageVersion" BeforeTargets="BeforeBuild" Condition="'$(WindowsPackageType)' == 'MSIX'">
    <XmlPeek
      XmlInputPath="Package.appxmanifest"
      Query="/m:Package/m:Identity/@Version"
      Namespaces="&lt;Namespace Prefix='m' Uri='http://schemas.microsoft.com/appx/manifest/foundation/windows10' /&gt;">
      <Output TaskParameter="Result" PropertyName="PackageManifestVersion" />
    </XmlPeek>
    <Error
      Condition="'$(PackageManifestVersion)' != '$(Version).0'"
      Text="Package.appxmanifest has version $(PackageManifestVersion), but &lt;Version&gt; is $(Version). Set it to $(Version).0." />
  </Target>

</Project>
