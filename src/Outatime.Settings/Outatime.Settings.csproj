<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>Outatime.Settings</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <Platform Condition="'$(Platform)' == '' Or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>..\Outatime\icons\outatime.ico</ApplicationIcon>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- GitHub Actions sets CI=true: warnings fail CI without stopping local builds. -->
    <TreatWarningsAsErrors Condition="'$(CI)' == 'true'">true</TreatWarningsAsErrors>
    <!-- Outatime.exe takes its version from here too (src/Outatime/CMakeLists.txt). -->
    <Version>0.1.0</Version>
    <DefaultLanguage>en-US</DefaultLanguage>
    <!-- Program.Main handles single-instance redirection before starting XAML. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>

    <UseWinUI>true</UseWinUI>
    <!-- Unpackaged app, distributed as a zip -->
    <WindowsPackageType>None</WindowsPackageType>
    <!-- Needed even when unpackaged: without it the app's .pri is left out of publish. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <PublishAot>true</PublishAot>

    <!-- Same layout as the zip: Outatime.exe + settings\Outatime.Settings.exe -->
    <OutDir>$(MSBuildThisFileDirectory)..\..\build\bin\$(Configuration)\settings\</OutDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- Shown in the About section. -->
    <Content Include="..\Outatime\icons\outatime.png" Link="Assets\outatime.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <!-- Unused parts of the Windows App SDK; excluding them keeps ~40 MB of DLLs out of the zip. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.AI" Version="2.5.5" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.ML" Version="2.1.94" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Search" Version="2.5.5" ExcludeAssets="all" />
  </ItemGroup>

</Project>
