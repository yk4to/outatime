<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Outatime.Settings.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Padding="16,0,0,0">
            <TextBlock
                x:Name="AppTitleText"
                VerticalAlignment="Center"
                Style="{StaticResource CaptionTextBlockStyle}" />
        </Grid>

        <ScrollViewer Grid.Row="1">
            <StackPanel
                MaxWidth="1000"
                Padding="36,0,36,36"
                Spacing="4">
                <TextBlock
                    x:Uid="SettingsTitle"
                    Margin="0,0,0,20"
                    Style="{StaticResource TitleTextBlockStyle}" />

                <controls:SettingsCard x:Uid="ModeCard">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE765;" />
                    </controls:SettingsCard.HeaderIcon>
                    <ComboBox x:Name="ModeComboBox" SelectionChanged="ModeComboBox_SelectionChanged">
                        <ComboBoxItem x:Uid="ModeToggle" Tag="toggle" />
                        <ComboBoxItem x:Uid="ModeLeftOffRightOn" Tag="leftOffRightOn" />
                        <ComboBoxItem x:Uid="ModeDisabled" Tag="disabled" />
                    </ComboBox>
                </controls:SettingsCard>

                <controls:SettingsCard x:Uid="StartupCard">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE7E8;" />
                    </controls:SettingsCard.HeaderIcon>
                    <!-- Item order matches StartupMode. -->
                    <ComboBox x:Name="StartupComboBox" SelectionChanged="StartupComboBox_SelectionChanged">
                        <ComboBoxItem x:Uid="StartupOff" />
                        <ComboBoxItem x:Uid="StartupNormal" />
                        <ComboBoxItem x:Uid="StartupElevated" />
                    </ComboBox>
                </controls:SettingsCard>

                <!-- Shown when the running resident's privilege level differs from the startup setting. -->
                <InfoBar
                    x:Name="RestartInfoBar"
                    IsClosable="False"
                    Severity="Warning">
                    <InfoBar.ActionButton>
                        <Button x:Name="RestartButton" x:Uid="RestartButton" Click="RestartButton_Click" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <TextBlock
                    x:Uid="AboutHeader"
                    Margin="1,28,0,4"
                    Style="{StaticResource BodyStrongTextBlockStyle}" />

                <controls:SettingsCard x:Name="AboutCard" x:Uid="AboutCard">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE946;" />
                    </controls:SettingsCard.HeaderIcon>
                    <!-- Selectable so it can be copied into bug reports. -->
                    <TextBlock
                        x:Name="BuildInfoText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        IsTextSelectionEnabled="True" />
                </controls:SettingsCard>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
