<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Outatime.Settings.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" />

        <ScrollViewer Grid.Row="1">
            <StackPanel
                MaxWidth="1000"
                Padding="36,0,36,36"
                Spacing="4">
                <TextBlock
                    x:Uid="SettingsTitle"
                    Margin="0,0,0,20"
                    Style="{StaticResource TitleTextBlockStyle}" />

                <!-- Shown when the running resident was built from a different commit than this app. -->
                <InfoBar
                    x:Name="BuildMismatchInfoBar"
                    x:Uid="BuildMismatchInfoBar"
                    Margin="0,0,0,8"
                    IsClosable="False"
                    Severity="Warning">
                    <InfoBar.ActionButton>
                        <Button x:Uid="RestartButton" Click="RestartButton_Click" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <!-- Settings only take effect while the resident process runs. -->
                <InfoBar
                    x:Name="NotRunningInfoBar"
                    x:Uid="NotRunningInfoBar"
                    Margin="0,0,0,8"
                    IsClosable="False"
                    Severity="Warning">
                    <InfoBar.ActionButton>
                        <Button x:Name="StartButton" x:Uid="StartButton" Click="StartButton_Click" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <!-- Each combo box's Tag is the key's name under "keys" in settings.json. -->
                <controls:SettingsExpander x:Uid="KeysExpander" IsExpanded="True">
                    <controls:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE765;" />
                    </controls:SettingsExpander.HeaderIcon>
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard x:Uid="LeftAltCard">
                            <ComboBox x:Name="LeftAltComboBox" SelectionChanged="KeyComboBox_SelectionChanged" Tag="leftAlt">
                                <ComboBoxItem x:Uid="KeyActionToggle" Tag="toggle" />
                                <ComboBoxItem x:Uid="KeyActionOn" Tag="on" />
                                <ComboBoxItem x:Uid="KeyActionOff" Tag="off" />
                                <ComboBoxItem x:Uid="KeyActionNone" Tag="none" />
                            </ComboBox>
                        </controls:SettingsCard>
                        <controls:SettingsCard x:Uid="RightAltCard">
                            <ComboBox x:Name="RightAltComboBox" SelectionChanged="KeyComboBox_SelectionChanged" Tag="rightAlt">
                                <ComboBoxItem x:Uid="KeyActionToggle" Tag="toggle" />
                                <ComboBoxItem x:Uid="KeyActionOn" Tag="on" />
                                <ComboBoxItem x:Uid="KeyActionOff" Tag="off" />
                                <ComboBoxItem x:Uid="KeyActionNone" Tag="none" />
                            </ComboBox>
                        </controls:SettingsCard>
                        <controls:SettingsCard x:Uid="LeftWinCard">
                            <ComboBox x:Name="LeftWinComboBox" SelectionChanged="KeyComboBox_SelectionChanged" Tag="leftWin">
                                <ComboBoxItem x:Uid="KeyActionToggle" Tag="toggle" />
                                <ComboBoxItem x:Uid="KeyActionOn" Tag="on" />
                                <ComboBoxItem x:Uid="KeyActionOff" Tag="off" />
                                <ComboBoxItem x:Uid="KeyActionNone" Tag="none" />
                            </ComboBox>
                        </controls:SettingsCard>
                        <controls:SettingsCard x:Uid="RightWinCard">
                            <ComboBox x:Name="RightWinComboBox" SelectionChanged="KeyComboBox_SelectionChanged" Tag="rightWin">
                                <ComboBoxItem x:Uid="KeyActionToggle" Tag="toggle" />
                                <ComboBoxItem x:Uid="KeyActionOn" Tag="on" />
                                <ComboBoxItem x:Uid="KeyActionOff" Tag="off" />
                                <ComboBoxItem x:Uid="KeyActionNone" Tag="none" />
                            </ComboBox>
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <controls:SettingsCard x:Uid="DoubleTapCard">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE7A7;" />
                    </controls:SettingsCard.HeaderIcon>
                    <ToggleSwitch
                        x:Name="DoubleTapToggle"
                        Tag="doubleTap"
                        Toggled="SettingToggle_Toggled" />
                </controls:SettingsCard>

                <controls:SettingsCard x:Uid="FullScreenCard">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE7FC;" />
                    </controls:SettingsCard.HeaderIcon>
                    <ComboBox
                        x:Name="FullScreenComboBox"
                        SelectionChanged="SettingComboBox_SelectionChanged"
                        Tag="pauseInFullScreen">
                        <ComboBoxItem x:Uid="FullScreenOff" Tag="off" />
                        <ComboBoxItem x:Uid="FullScreenGames" Tag="games" />
                        <ComboBoxItem x:Uid="FullScreenAll" Tag="all" />
                    </ComboBox>
                </controls:SettingsCard>

                <controls:SettingsCard x:Uid="InjectedKeysCard">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE8AF;" />
                    </controls:SettingsCard.HeaderIcon>
                    <ToggleSwitch
                        x:Name="InjectedKeysToggle"
                        Tag="acceptInjectedKeys"
                        Toggled="SettingToggle_Toggled" />
                </controls:SettingsCard>

                <controls:SettingsCard x:Uid="StartupCard">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE7E8;" />
                    </controls:SettingsCard.HeaderIcon>
                    <!-- Item order matches StartupMode. -->
                    <ComboBox x:Name="StartupComboBox" SelectionChanged="StartupComboBox_SelectionChanged">
                        <ComboBoxItem x:Uid="StartupOff" />
                        <ComboBoxItem x:Uid="StartupNormal" />
                        <ComboBoxItem x:Uid="StartupElevated" />
                    </ComboBox>
                </controls:SettingsCard>

                <!-- Shown when the running resident's privilege level differs from the startup setting. -->
                <InfoBar
                    x:Name="RestartInfoBar"
                    IsClosable="False"
                    Severity="Warning">
                    <InfoBar.ActionButton>
                        <Button x:Name="RestartButton" x:Uid="RestartButton" Click="RestartButton_Click" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <controls:SettingsCard x:Name="SettingsFileCard" x:Uid="SettingsFileCard">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE8A5;" />
                    </controls:SettingsCard.HeaderIcon>
                    <Button x:Uid="OpenSettingsFileButton" Click="OpenSettingsFileButton_Click" />
                </controls:SettingsCard>

                <TextBlock
                    x:Uid="AboutHeader"
                    Margin="1,28,0,4"
                    Style="{StaticResource BodyStrongTextBlockStyle}" />

                <controls:SettingsExpander x:Name="AboutExpander" x:Uid="AboutExpander" IsExpanded="True">
                    <controls:SettingsExpander.HeaderIcon>
                        <ImageIcon Source="ms-appx:///Assets/outatime.png" />
                    </controls:SettingsExpander.HeaderIcon>
                    <!-- Selectable so it can be copied into bug reports. -->
                    <TextBlock
                        x:Name="BuildInfoText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        IsTextSelectionEnabled="True" />
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard x:Uid="LicenseCard">
                            <HyperlinkButton x:Uid="RepositoryButton" NavigateUri="https://github.com/yk4to/outatime" />
                        </controls:SettingsCard>
                        <controls:SettingsCard x:Uid="ThirdPartyCard">
                            <Button x:Uid="OpenThirdPartyNoticesButton" Click="OpenThirdPartyNoticesButton_Click" />
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
